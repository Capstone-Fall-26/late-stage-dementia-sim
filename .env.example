# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM backend selection ---
# One of: "ollama", "gemini", "azure"
LLM_BACKEND=ollama

# --- Ollama (local) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Google Gemini ---
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- Azure OpenAI ---
# Create a resource + deploy a chat model at https://portal.azure.com
# (Azure OpenAI Studio: https://oai.azure.com). Never commit real values.
# Resource -> "Keys and Endpoint" blade:
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com
# The *deployment name* you gave the model in Azure OpenAI Studio, not the
# underlying model name (e.g. "gpt-4o-mini-deployment", not "gpt-4o-mini").
AZURE_OPENAI_DEPLOYMENT=
# API version supported by your deployment; see
# https://learn.microsoft.com/azure/ai-services/openai/reference
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Milvus Lite ---
MILVUS_DB_PATH=./milvus_patient_memory.db
EMBEDDING_BACKEND=hashing
# EMBEDDING_BACKEND=sentence-transformer
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# --- Simulation defaults ---
DEFAULT_PATIENT_PROFILE=config/patient_profiles/stage7_late.json
DEFAULT_STAGE=7
RNG_SEED=

# --- Logging ---
LOG_DIR=logs
LOG_LEVEL=INFO
