# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM backend selection ---
# One of: "ollama", "gemini", "azure"
LLM_BACKEND=ollama

# --- Ollama (local) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Google Gemini ---
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- Azure OpenAI (Azure AI Foundry) ---
# Create a resource + deploy a chat model at https://ai.azure.com (Azure AI
# Foundry; the old Azure OpenAI Studio URL redirects here). Never commit
# real values. Resource -> "Keys and Endpoint" page:
AZURE_OPENAI_API_KEY=
# Paste the endpoint exactly as Azure gives it. Both shapes work and are
# auto-detected -- no need to edit it:
#   classic:        https://<resource-name>.openai.azure.com
#   Foundry project: https://<resource>.services.ai.azure.com/api/projects/<project>/openai/v1/responses
AZURE_OPENAI_ENDPOINT=
# The *deployment name* from the Foundry "Deployments" tab, not the
# underlying model name (e.g. "gpt-4.1-mini-deployment", not "gpt-4.1-mini"
# -- though Foundry often names the deployment after the model by default).
AZURE_OPENAI_DEPLOYMENT=
# Only used for the classic endpoint shape above; ignored for Foundry
# project endpoints. See https://learn.microsoft.com/azure/ai-services/openai/reference
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Milvus Lite ---
MILVUS_DB_PATH=./milvus_patient_memory.db
EMBEDDING_BACKEND=hashing
# EMBEDDING_BACKEND=sentence-transformer
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# --- Simulation defaults ---
DEFAULT_PATIENT_PROFILE=config/patient_profiles/stage7_late.json
DEFAULT_STAGE=7
RNG_SEED=

# --- Logging ---
LOG_DIR=logs
LOG_LEVEL=INFO
