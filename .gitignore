# Evaluation artifacts
evaluation/results/*.json
evaluation/results/*.csv
!evaluation/results/.gitkeep
evaluation/plots/*.png
!evaluation/plots/.gitkeep

# Testing / tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editor / OS
.vscode/
.idea/
.DS_Store
